# Copy to backend/.env for local development. NEVER commit the real .env.
# In AWS these values are injected from AWS Secrets Manager at container start.
PORT=5000
NODE_ENV=development

# PostgreSQL (either DATABASE_URL or the DB_* variables)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=craftkart
DB_USER=craftkart
DB_PASSWORD=change-me
DB_SSL=false
# DATABASE_URL=postgres://craftkart:change-me@localhost:5432/craftkart

# JWT (generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
JWT_SECRET=change-me
JWT_EXPIRE=24h

# Stripe TEST keys (optional - card checkout is disabled without them)
STRIPE_SECRET_KEY=

# Public URL of the web tier (used for CORS and Stripe redirect URLs)
FRONTEND_URL=http://localhost:3000

# Initial admin account created by `npm run seed`
ADMIN_EMAIL=admin@craftkart.com
ADMIN_PASSWORD=Admin@123456
