# cp terraform.tfvars.example terraform.tfvars   (terraform.tfvars is git-ignored)
aws_region        = "ap-south-1"
github_repository = "YOUR_GITHUB_USERNAME/craftkart"

# Stripe TEST secret key (optional). Leave "" to disable card checkout.
stripe_secret_key = ""

# Receive CloudWatch alarm e-mails (confirm the subscription e-mail from AWS)
alarm_email = ""

# Cost/HA trade-offs
single_nat_gateway   = true    # false = NAT per AZ (HA, +~$35/month)
db_multi_az          = false   # true  = RDS standby in 2nd AZ (not free tier)
web_desired_capacity = 2
app_desired_capacity = 2

# Set false if your account already has the GitHub OIDC provider
create_github_oidc_provider = true
