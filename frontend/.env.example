# Copy to frontend/.env for `npm start` (local dev without Docker)
REACT_APP_API_URL=http://localhost:5000/api
# Supabase storage is used by the browser for product images / seller documents.
# The anon key is a PUBLIC key by design (it ships to every browser).
REACT_APP_SUPABASE_URL=https://your-project.supabase.co
REACT_APP_SUPABASE_ANON_KEY=your-supabase-anon-key
REACT_APP_BUCKET_NAME=craftkart
REACT_APP_DOCS_BUCKET=seller-documents
